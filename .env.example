# Paste your CURRENT ngrok https origin (from "ngrok http 5000"). No /api suffix.
# Free ngrok URLs change when you restart the tunnel — update .env and: npx expo start -c
EXPO_PUBLIC_API_BASE_URL=https://YOUR-CURRENT-SUBDOMAIN.ngrok-free.app
EXPO_PUBLIC_TRACKING_SOCKET_URL=https://YOUR-CURRENT-SUBDOMAIN.ngrok-free.app
